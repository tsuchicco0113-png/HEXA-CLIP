#!/usr/bin/env python3
"""czclip — HEXA CLIP のコマンド

  czclip paste [N]        最新(またはN番目に新しい)を出力   例: czclip paste > main.py
  czclip push [TEXT...]   送る(TEXT省略時は標準入力)         例: czclip push < log.txt
  czclip send FILE...     ファイルを名前付きで送る (スマホ/PCの履歴からDLできる)
  czclip list [N]         履歴一覧(既定10件)
  czclip find 語...       履歴を検索 (本文・ファイル名)
  czclip star ID          ピン留め★ (履歴が流れても残る)   czclip unstar ID で外す
  czclip get ID           ID指定で出力
  czclip rm ID            削除
  czclip top ID           最新に移す (本体の fn+V で貼り付ける対象になる)
  czclip pin              スマホ接続用のURLとPINを表示
  czclip qr               スマホ接続用のQRコードを端末に表示 (読むだけでログイン)
  czclip token [reset]    共有シート/ショートカット用のトークンと送り方を表示 (reset で作り直し)
  czclip logout-all       全端末をログアウト(PINは czclipd --reset-pin で変更)
"""
import json
import os
import sys
import urllib.error
import urllib.request

BASE = os.environ.get("HEXACLIP_URL", "http://127.0.0.1:8080")


def call(method, path, body=None):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(BASE + path, data=data, method=method,
                                 headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=5) as r:
            return json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        sys.exit(f"czclip: error {e.code} {e.read().decode(errors='replace')}")
    except urllib.error.URLError:
        sys.exit("czclip: czclipd に接続できません (systemctl status hexaclip を確認)")


def one_line(s, n=60):
    s = s.replace("\n", " ⏎ ")
    return s if len(s) <= n else s[:n - 1] + "…"


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    cmd, args = argv[0], argv[1:]
    if cmd in ("get", "rm", "top") and (not args or not args[0].isdigit()):
        sys.exit(f"czclip: {cmd} には ID が必要です (例: czclip {cmd} 12 / IDは czclip list で確認)")

    if cmd == "paste":
        n = int(args[0]) if args else 1
        items = call("GET", f"/api/items?limit={n}")["items"]
        if len(items) < n:
            sys.exit("czclip: 履歴がありません")
        sys.stdout.write(items[n - 1]["text"])
        if sys.stdout.isatty() and not items[n - 1]["text"].endswith("\n"):
            sys.stdout.write("\n")
    elif cmd == "push":
        text = " ".join(args) if args else sys.stdin.read()
        r = call("POST", "/api/items", {"text": text, "source": "cli"})
        print(f"pushed #{r['id']}", file=sys.stderr)
    elif cmd == "send":
        if not args:
            sys.exit("czclip: send にはファイルを指定してください (例: czclip send log.txt)")
        from urllib.parse import quote
        for path in args:
            try:
                data = open(path, "rb").read()
            except OSError as e:
                sys.exit(f"czclip: {path}: {e.strerror}")
            req = urllib.request.Request(
                BASE + "/api/files?source=cli&name=" + quote(os.path.basename(path)),
                data=data, method="POST")
            try:
                with urllib.request.urlopen(req, timeout=60) as r:
                    j = json.loads(r.read())
            except urllib.error.HTTPError as e:
                sys.exit(f"czclip: {path}: error {e.code} {e.read().decode(errors='replace')}")
            except urllib.error.URLError:
                sys.exit("czclip: czclipd に接続できません (systemctl status hexaclip を確認)")
            print(f"sent #{j['id']} {j['name']} ({j['size']}B)", file=sys.stderr)
    elif cmd == "find":
        if not args:
            sys.exit("czclip: find には検索語が必要です")
        from urllib.parse import quote
        its = call("GET", "/api/items?limit=50&q=" + quote(" ".join(args)))["items"]
        if not its:
            print("見つかりません", file=sys.stderr)
        for it in its:
            body = f"({it.get('size', 0)}B)" if it.get("binary") else one_line(it["text"])
            name = f"{it['name']}: " if it.get("name") else ""
            print(f"{'★' if it.get('pinned') else ' '}#{it['id']:<5} [{it['source']:<4}] {one_line(name + body)}")
    elif cmd in ("star", "unstar"):
        if not args or not args[0].isdigit():
            sys.exit(f"czclip: {cmd} には ID が必要です")
        call("POST", f"/api/items/{int(args[0])}/pin", {"on": cmd == "star"})
        print(("★ " if cmd == "star" else "unstarred ") + f"#{args[0]}", file=sys.stderr)
    elif cmd == "list":
        n = int(args[0]) if args else 10
        for it in call("GET", f"/api/items?limit={n}")["items"]:
            body = f"({it.get('size', 0)}B)" if it.get("binary") else one_line(it["text"])
            name = f"{it['name']}: " if it.get("name") else ""
            print(f"#{it['id']:<5} [{it['source']:<4}] {one_line(name + body)}")
    elif cmd == "get":
        sys.stdout.write(call("GET", f"/api/items/{int(args[0])}")["text"])
    elif cmd == "top":
        r = call("POST", f"/api/items/{int(args[0])}/top", {})
        print(f"#{args[0]} -> #{r['id']} (最新)", file=sys.stderr)
    elif cmd == "rm":
        call("DELETE", f"/api/items/{int(args[0])}")
        print("deleted", file=sys.stderr)
    elif cmd == "pin":
        r = call("GET", "/api/pin")
        print(f"URL: {r['url']}\nPIN: {r['pin']}")
        if r.get("mdns"):
            print(f"名前: {r['mdns']}  (IPが変わっても同じ。対応していない端末もあります)")
        if r.get("online") is False:
            print("※ Wi-Fi に接続されていません")
    elif cmd == "token":
        r = call("POST", "/api/token/reset", {}) if args[:1] == ["reset"] else call("GET", "/api/token")
        p = call("GET", "/api/pin")
        base = (p.get("mdns") or p["url"]).rstrip("/")
        print(f"TOKEN: {r['token']}\n")
        print("送る (スマホ→CPZ):")
        print(f"  POST {base}/api/items")
        print(f"  ヘッダ  Authorization: Bearer {r['token']}")
        print("          Content-Type: text/plain")
        print("  本文    送りたい文字\n")
        print("受け取る (CPZ→スマホ):")
        print(f"  GET  {base}/api/latest   (同じ Authorization ヘッダ)\n")
        print(f"例: curl -H 'Authorization: Bearer {r['token']}' -H 'Content-Type: text/plain' \\")
        print(f"      --data-binary @memo.txt {base}/api/items")
    elif cmd == "qr":
        r = call("GET", "/api/pin")
        try:
            import qrcode
            q = qrcode.QRCode(border=2)
            q.add_data(r["url"] + "#pin=" + r["pin"])
            q.print_ascii(invert=True)
        except ImportError:
            print("(QR表示には sudo apt install python3-qrcode が必要)")
        print(f"URL: {r['url']}\nPIN: {r['pin']}")
    elif cmd == "logout-all":
        call("POST", "/api/logout_all", {})
        print("all sessions cleared", file=sys.stderr)
    else:
        sys.exit(f"czclip: unknown command '{cmd}' (czclip help)")


if __name__ == "__main__":
    main(sys.argv[1:])
